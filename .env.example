# Ontelic public configuration
#
# All entries are optional. The installed launcher discovers its own runtime
# directory; do not copy a developer-machine path into another installation.

JARVIS_HOST=127.0.0.1
JARVIS_PORT=8091
JARVIS_PROFILE_MAX_CHARS=6000

# Official Ollama tags. The first-run model picker writes the verified choice
# to data/model_selection.json and takes precedence over these fallbacks.
JARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=gemma4:26b-a4b-it-qat
# JARVIS_OLLAMA_CHAT_MODEL=gemma4:26b-a4b-it-qat
JARVIS_OLLAMA_CODE_MODEL=qwen3.8:27b-mtp-q4_K_M
JARVIS_OLLAMA_VISION_MODEL=gemma4:26b-a4b-it-qat
JARVIS_OLLAMA_CODE_NUM_CTX=102400
JARVIS_OLLAMA_NUM_CTX=131072
JARVIS_OLLAMA_MIN_NUM_CTX=16384
JARVIS_OLLAMA_KEEP_ALIVE=24h
JARVIS_STARTUP_WARMUP_ENABLED=true
JARVIS_SELF_CHECK_EXPECTED_GPUS=0

# Optional personalisation. Empty means the neutral UI label "사용자" and no
# salutation is injected into model prompts.
JARVIS_USER_LABEL=

# Local files and Windows automation. Semicolon-separated paths may be added;
# when omitted, Desktop, Documents, Downloads, and Ontelic output folders are used.
# JARVIS_LOCAL_FILE_ALLOWED_ROOTS=D:\work;D:\documents
JARVIS_LOCAL_COMPUTER_ENABLED=true
JARVIS_WINDOWS_CONTROL_ENABLED=true
JARVIS_ENABLE_SYSTEM_ACTIONS=false

# Browser writes are opt-in. Irreversible actions still require approval.
JARVIS_BROWSER_ENABLED=true
JARVIS_BROWSER_HOME_URL=https://www.google.com
JARVIS_BROWSER_READ_ONLY=true
JARVIS_BROWSER_SANDBOX=true
JARVIS_BROWSER_VISUAL_OVERLAY=true

# Voice uses the default input device and GPU 0 unless overridden.
JARVIS_VOICE_ENABLED=true
JARVIS_MICROPHONE_NAME=
JARVIS_STT_MODEL=large-v3-turbo
JARVIS_STT_DEVICE=cuda
JARVIS_STT_DEVICE_INDEX=0
JARVIS_VISION_DEVICE=cuda:0
JARVIS_STT_COMPUTE_TYPE=int8_float16
JARVIS_HOTKEY_ENABLED=true
JARVIS_HOTKEY=f9
JARVIS_TTS_ENABLED=true
JARVIS_SUPERTONIC_BASE_URL=http://127.0.0.1:7788
JARVIS_SUPERTONIC_TASK_NAME=Alture-Jarvis-Supertonic

# Optional physical camera/face integration. Disabled until the user supplies
# their own device settings; no office tablet or private-network address is assumed.
JARVIS_CAMERA_ENABLED=false
JARVIS_CAMERA_CONTROL_ENABLED=false
JARVIS_CAMERA_SCREEN_CAPTURE=false
JARVIS_FACE_RECOGNITION_ENABLED=false
# JARVIS_CAMERA_NAME=
# JARVIS_CAMERA_CONTROL_ADB_SERIAL=
# JARVIS_CAMERA_STREAM_URL=rtsp://192.168.1.50:554/stream1

# Google is available only when the signed product build contains the app-owned
# desktop OAuth client in resources/google_oauth_client.json. End users do not
# create or download a client-secret file. Write scopes remain opt-in.
JARVIS_GOOGLE_ENABLED=true
JARVIS_GOOGLE_WRITE_ENABLED=false
JARVIS_CALENDAR_DEFAULT_TIMEZONE=Asia/Seoul

# Product/domain apps are explicit opt-ins. These defaults keep a public install
# independent of private services and Korean-only account automation.
JARVIS_INHOUSE_DATA_ENABLED=false
JARVIS_INHOUSE_API_BASE=
JARVIS_INHOUSE_API_KEY=
JARVIS_INHOUSE_API_HEADER=X-API-Key
JARVIS_INHOUSE_TENANT_ID=
JARVIS_PLOPFIT_ENABLED=false
JARVIS_PLOPFIT_FUNCTIONS_DIR=
JARVIS_PLOPFIT_LIB_DIR=
JARVIS_NAVER_BLOG_ENABLED=false

# Legacy private primary/satellite updating is not the public release channel.
# Enable it only on an explicitly managed private installation.
JARVIS_PRIVATE_UPDATE_ENABLED=false
JARVIS_ROLE=primary
JARVIS_BRAIN_HOST=

# Packager/managed-deployment inputs (not end-user setup). A published build may
# inject these instead of bundling resources/google_oauth_client.json.
# JARVIS_GOOGLE_OAUTH_CLIENT_ID=
# JARVIS_GOOGLE_OAUTH_CLIENT_SECRET=
# JARVIS_GOOGLE_PROJECT_ID=
